<odoo>
    <data noupdate="1">
        <!-- Tenants -->
        <record id="tenant_1" model="real_estate.tenant">
            <field name="name">John Smith</field>
            <field name="email">john.smith@example.com</field>
            <field name="phone">555-0101</field>
            <field name="date_of_birth">1985-05-15</field>
            <field name="property_type">house</field>
            <field name="notes">Long-term tenant, preferred contact via email.</field>
        </record>

        <record id="tenant_2" model="real_estate.tenant">
            <field name="name">Alice Johnson</field>
            <field name="email">alice.j@example.com</field>
            <field name="phone">555-0102</field>
            <field name="date_of_birth">1992-11-20</field>
            <field name="property_type">house</field>

        </record>

        <record id="tenant_3" model="real_estate.tenant">
            <field name="name">Michael Brown</field>
            <field name="email">m.brown@example.com</field>
            <field name="phone">555-0103</field>
            <field name="date_of_birth">1978-02-10</field>
            <field name="property_type">house</field>

        </record>

        <!-- Properties -->
        <record id="property_1" model="real_estate.property">
            <field name="name">Sunset Apartment 302</field>
            <field name="property_type">apartment</field>
            <field name="price">1200.0</field>
            <field name="deposit_required">1200.0</field>
            <field name="bed_rooms">2</field>
            <field name="bath_rooms">1</field>
            <field name="deposit_required">850.0</field>
            <field name="description">Beautiful sunset view from the balcony. Recently renovated.</field>
            <field name="available">True</field>
        </record>

        <record id="property_2" model="real_estate.property">
            <field name="name">Oakwood Suburban House</field>
            <field name="property_type">house</field>
            <field name="price">2500.0</field>
            <field name="deposit_required">3000.0</field>
            <field name="bed_rooms">4</field>
            <field name="bath_rooms">3</field>
            <field name="deposit_required">2200.0</field>
            <field name="description">Spacious house with a large backyard and 2-car garage.</field>
            <field name="available">False</field>
        </record>

        <record id="property_3" model="real_estate.property">
            <field name="name">Crystal Villa</field>
            <field name="property_type">villa</field>
            <field name="price">5000.0</field>
            <field name="deposit_required">7500.0</field>
            <field name="bed_rooms">5</field>
            <field name="bath_rooms">5</field>
            <field name="deposit_required">4500.0</field>
            <field name="description">Luxury villa with private pool and garden.</field>
            <field name="available">True</field>
        </record>

        <record id="property_4" model="real_estate.property">
            <field name="name">Downtown Commercial HUB</field>
            <field name="property_type">commercial</field>
            <field name="price">3500.0</field>
            <field name="deposit_required">5000.0</field>
            <field name="bed_rooms">1</field> <!-- Required field in model -->
            <field name="bath_rooms">2</field>
            <field name="deposit_required">1500.0</field>
            <field name="description">Prime location for retail or office space.</field>
            <field name="available">True</field>
        </record>

        <!-- Leases -->
        <record id="lease_1" model="real_estate.lease">
            <field name="property_id" ref="property_2"/>
            <field name="tenant_id" ref="tenant_1"/>
            <field name="start_date" eval="(datetime.now() - timedelta(days=90)).strftime('%Y-%m-%d')"/>
            <field name="end_date" eval="(datetime.now() + timedelta(days=275)).strftime('%Y-%m-%d')"/>
            <field name="monthly_rent">2500.0</field>
            <field name="deposit_paid">3000.0</field>
            <field name="state">active</field>
        </record>

        <record id="lease_2" model="real_estate.lease">
            <field name="property_id" ref="property_1"/>
            <field name="tenant_id" ref="tenant_2"/>
            <field name="start_date" eval="(datetime.now() + timedelta(days=10)).strftime('%Y-%m-%d')"/>
            <field name="end_date" eval="(datetime.now() + timedelta(days=375)).strftime('%Y-%m-%d')"/>
            <field name="monthly_rent">1200.0</field>
            <field name="deposit_paid">1200.0</field>
            <field name="state">draft</field>
        </record>
    </data>
</odoo>