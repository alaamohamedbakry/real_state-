<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_lease_summary">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="lease">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Lease Summary:
                            <span t-field="lease.name"/>
                        </h2>
                        <!-- Lease Details -->
                        <div class="row mt-4">
                            <div class="col-6">
                                <strong>Property:</strong>
                                <span t-field="lease.property_id.name"/>
                            </div>
                            <div class="col-6">
                                <strong>Tenant:</strong>
                                <span t-field="lease.tenant_id.name"/>
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-6">
                                <strong>Start Date:</strong>
                                <br/>
                                <span t-field="lease.start_date"/>
                                <strong>End Date:</strong>
                                <span t-field="lease.end_date"/> sqft
                                <br/>
                            </div>
                        </div>
                        <!-- Active Lease Info -->
                        <t t-if="lease.maintenance_ids">
                            <div class="row mt-4">
                                <div class="col-12">
                                    <h4>Maintence:</h4>
                                    <table class="table table-sm">
                                        <t t-foreach="lease.maintenance_ids" t-as="maintenance">
                                            <tr>
                                                <td>
                                                    <strong>Issue Type:</strong>
                                                </td>
                                                <td>
                                                    <span t-field="maintenance.issue_type"/>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>
                                                    <strong>Urgency:</strong>
                                                </td>
                                                <td>
                                                    <span t-field="maintenance.urgency"/>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>
                                                    <strong>Assigned To:</strong>
                                                </td>
                                                <td>
                                                    <span t-field="maintenance.assigned_to"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </table>
                                </div>
                            </div>
                        </t>
                        <t t-else="">
                            <p class="text-muted">No  maintenances</p>
                        </t>
                        <!-- Footer Note -->
                        <div class="row mt-5">
                            <div class="col-12">
                                <p class="text-muted">
                                    <small>
                                        Generated on
                                        <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')"/>
                                    </small>
                                </p>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>