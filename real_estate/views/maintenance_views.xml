<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_real_estate_maintenance_tree" model="ir.ui.view">
        <field name="name">real_estate.maintenance.tree</field>
        <field name="model">maintenance.request</field>
        <field name="arch" type="xml">
            <tree string="Tenants">
                <field name="name"/>
                <field name="lease_id"/>
                <field name="state"/>
                <field name="assigned_to"/>
                <field name="completion_date"/>
                <field name="actual_cost"/>
                <field name="preferred_date"/>
            </tree>
        </field>
    </record>
    <record id="real_estate_maintenance_form" model="ir.ui.view">
        <field name="name">real_estate.view.form</field>
        <field name="model">maintenance.request</field>
        <field name="arch" type="xml">
            <form string="Tenants">
               <header>
                 <field name="state" widget="statusbar"/>
               </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Enter your tenant name"/>
                        </h1>
                    </div>
                    <group string="Maintenance Details">
                        <group>
                            <field name="actual_cost"/>
                        </group>
                        <group string="Related types">
                            <field name="lease_id"/>
                            <field name="property_id"/>
                            <field name="tenant_id"/>
                            <field name="tenant_phone"/>
                        </group>
                        <group string="Dates Info">
                            <field name="preferred_date"/>
                            <field name="scheduled_date"/>
                            <field name="completion_date"/>
                        </group>
                        <group string="Info Maintenance">
                            <field name="issue_type"/>
                            <field name="urgency"/>
                            <field name="state"/>
                            <field name="assigned_to"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Images">
                            <field name="images_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="image" widget="image" options="{'size': [60, 60]} "/>
                                </tree>
                            </field>
                        </page>
                        <page string="Any comment">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
</odoo>