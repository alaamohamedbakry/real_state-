<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_tree" model="ir.ui.view">
        <field name="name">real_estate.property.tree</field>
        <field name="model">real_estate.property</field>
        <field name="arch" type="xml">
            <tree string="Properties">
                <field name="name"/>
                <field name="description"/>
                <field name="price"/>
                <field name="agent_id"/>
                <field name="bed_rooms"/>
                <field name="bath_rooms"/>
                <field name="floor"/>
                <field name="address"/>
                <field name="city"/>
                <field name="property_type"/>
                <field name="available"/>
                <field name="created_from_api"/>
            </tree>
        </field>
    </record>
    <!--property Search view-->
    <record id="view_property_search" model="ir.ui.view">
        <field name="name">real_estate.property.search</field>
        <field name="model">real_estate.property</field>
        <field name="arch" type="xml">
            <search string="Search Leases">
                <field name="name"/>
                <field name="price"/>
                <field name="agent_id"/>
                <separator/>
                <filter string="Available" name="available" domain="[('available','=',True)]"/>
                <filter string="Created from Api" name="created_from_api" domain="[('created_from_api','=',True)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Type" name="group_by_type" context="{'group_by': 'property_type'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="model_name_view_form" model="ir.ui.view">
        <field name="name">real_estate.property.form</field>
        <field name="model">real_estate.property</field>
        <field name="arch" type="xml">
            <form string="Property">
                <header>
                    <button name="mark_as_available" type="object" string="Mark as Available" class="oe_highlight"/>
                    <button name="mark_as_unavailable" type="object" string="Mark as Unavailable" class="btn-danger"/>
                    <button name="make_default_price" type="object" string="Change Monthly Rent" class="oe_highlight"/>
                    <button name="add_price" type="object" string="Add Price" class="oe_highlight" invisible="price > 1000"/>
                    <button name="get_available_properties" type="object" string="Get Available Properties" class="oe_highlight"/>
                    <button name="get_customer_data" type="object" string="Update Description" class="oe_highlight"/>
                    <button name="notify_agent_if_state_available" type="object" string="Send Mail To Agent" class="oe_highlight"/>
                    <button name="action_export_excel" type="object" string="Download Excel report" class="oe_highlight"/>
                    <button name="action_print_property_summary" type="object" string="Print report" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_leases"
                type="object"
                class="oe_stat_button"
                icon="fa-file-text-o">
                            <field name="lease_count"
                   string="Leases"
                   widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <field name="image_property"
               widget="image"
               class="oe_avatar"/>
                        <label for="name"/>
                        <h1>
                            <field name="name"
                   placeholder="Enter Your Property Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="price"/>
                            <field name="description"/>
                        </group>
                        <group>
                            <field name="address"/>
                            <field name="city"/>
                            <field name="property_type"/>
                        </group>
                        <group string="Agent Details">
                            <field name="agent_id"/>
                            <field name="deposit_required"/>
                        </group>
                        <group string="Property Details">
                            <field name="bed_rooms"/>
                            <field name="bath_rooms"/>
                            <field name="floor"/>
                            <field name="available"/>
                            <field name="lead_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Leases" >
                            <field name="lease_ids">
                                <tree editable="bottom"  create="false" delete="false">
                                    <field name="name"/>
                                    <field name="tenant_id"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="action_report_property_summary" model="ir.actions.report">
        <field name="name">Property Summary</field>
        <field name="model">real_estate.property</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">real_estate.report_property_summary</field>
        <field name="report_file">real_estate.report_property_summary</field>
        <field name="binding_model_id" ref="model_real_estate_property"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Property Summary - %s' % (object.name)</field>
    </record>
</odoo>