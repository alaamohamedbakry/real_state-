<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Tenant List View (Tree) -->
  <record id="view_tenant_tree" model="ir.ui.view">
    <field name="name">real_estate.lease.tree</field>
    <field name="model">real_estate.lease</field>
    <field name="arch" type="xml">
      <tree string="Lease">
        <field name="name"/>
        <field name="property_id"/>
        <field name="tenant_id"/>
        <field name="start_date"/>
        <field name="end_date"/>
        <field name="monthly_rent"/>
        <field name="state"/>
        <field name="created_by"/>
      </tree>
    </field>
  </record>
               <!--Lease Search view-->
  <record id="view_lease_search" model="ir.ui.view">
    <field name="name">real_estate.lease.search</field>
    <field name="model">real_estate.lease</field>
    <field name="arch" type="xml">
      <search string="Search Leases">
        <field name="name"/>
        <field name="property_id"/>
        <field name="tenant_id"/>
        <separator/>
        <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
        <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
        <filter string="At Risk" name="at_risk" domain="[('state', '=', 'at_risk')]"/>
        <filter string="Expired" name="expired" domain="[('state', '=', 'expired')]"/>
        <separator/>
        <group expand="0" string="Group By">
          <filter string="Property" name="group_by_property" context="{'group_by': 'property_id'}"/>
          <filter string="Tenant" name="group_by_tenant" context="{'group_by': 'tenant_id'}"/>
          <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
        </group>
      </search>
    </field>
  </record>
  <!--property form view-->
  <record id="real_estate_view_form" model="ir.ui.view">
    <field name="name">real_estate.view.form</field>
    <field name="model">real_estate.lease</field>
    <field name="arch" type="xml">
      <form string="Lease">
        <header>
          <field name="state" widget="statusbar" />
          <button name= "set_active"  string= "Mark as Active" type= "object" invisible="state=='active'" class="oe_highlight" groups="real_estate.group_property_manager" />
          <button name= "set_draft"  string= "Mark as Draft" type= "object" invisible="state in ['draft']" class="btn btn-success" />
          <button name= "set_at_risk"  string= "Mark as Risk" type= "object" invisible="state in ['at_risk']" class="btn btn-danger" />
          <button name= "set_expired"  string= "Mark as Expired" type= "object" invisible="state in ['expired']" class="oe_highlight" />
          <button name= "get_property_data"  string= "Get DATA Price Property" type= "object"  class="oe_highlight" />
          <button name= "send_reminder_email"  string= "Send Reminder due date" type= "object"  class="oe_highlight" />
          <button name= "send_reminder_email"  string= "Send Reminder " type= "object"  class="oe_highlight" />
          <button name= "%(real_estate.action_maintenance_request_wizard)d"  string= "Maintenance Request" type= "action" context="{'default_lease_id': active_id} "  invisible="state  in ['draft','at_risk','expired']"/>
          <button name= "%(real_estate.action_lease_request_wizard)d"  string= "Create New Lease" type= "action" context="{'default_lease_id': active_id} "  invisible="state  in ['draft','at_risk','expired']"/>
          <button name="%(real_estate.action_payment_request_wizard)d" string="Payment Reques" type="action" context="{'default_lease_id': active_id}" class="btn-primary"/>
        </header>
        <sheet>
          <div class="oe_title">
            <label for="name"/>
            <h1>
              <field name="name" placeholder="Enter your tenant name"></field>
            </h1>
          </div>
          <group string="Lease Details" >
            <group>
              <field name="property_id"></field>
              <field name="tenant_id"></field>
            </group>
            <group>
              <field name="start_date"></field>
              <field name="end_date"></field>
              <field name="duration_months"></field>
            </group>
            <group >
              <field name="monthly_rent"></field>
              <field name="deposit_paid" groups="real_estate.group_property_manager"></field>
              <field name="total_rent"></field>
            </group>
            <group>
              <field name="currency_id"></field>
              <field name="state"></field>
              <field name="created_by"></field>
              <field name="next_payment_date"></field>
              <!-- <field name="is_active"></field> -->
            </group>
            <group>
              <field name="note"></field>
            </group>
          </group>
        </sheet>
        <div class="oe_chatter">
          <field name="message_follower_ids"/>
          <field name="activity_ids"/>
          <field name="message_ids"/>
        </div>
      </form>
    </field>
  </record>
  <record id="ir_cron_auto_expire_leases" model="ir.cron">
    <field name="name">Real Estate: Auto Expire Leases</field>
    <field name="model_id" ref="model_real_estate_lease"/>
    <field name="state">code</field>
    <field name="code">model._cron_auto_expire_leases()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="numbercall">-1</field>
    <field name="doall" eval="False"/>
    <field name="active" eval="True"/>
  </record>
</odoo>