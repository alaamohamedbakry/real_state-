<odoo>
    <record id="crm_lead_view_form_inherit" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="before">
                <field name="property_type"/>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="string">sales man</attribute>
            </xpath> 
             <xpath expr="//field[@name='user_id']" position="after">
               <field name="tenant_created"/>
            </xpath>            
        </field>
    </record>



    <record id="view_crm_case_leads_filter_inherit_real_estate" model="ir.ui.view">
        <field name="name">crm.lead.search.inherit.real_estate</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter string="Created from API" name="created_from_api" domain="[('created_from_api','=', True)]"/>
            </xpath>
        </field>
    </record>
</odoo>